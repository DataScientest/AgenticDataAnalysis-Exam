# LLM used by the POC (Pages/graph/nodes.py): any OpenAI-compatible API.
# Export these variables before `streamlit run data_analysis_streamlit_app.py`.

# Groq (default)
LLM_API_BASE="https://api.groq.com/openai/v1"
LLM_API_KEY="your-groq-api-key-here"
LLM_MODEL="openai/gpt-oss-120b"

# OpenAI
# LLM_API_BASE="https://api.openai.com/v1"
